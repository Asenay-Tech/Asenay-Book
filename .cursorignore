# ============================================
# ASENAY-BOOK CURSOR IGNORE CONFIGURATION
# Optimized for Next.js + Supabase + TypeScript
# ============================================

# Dependencies - Never index these (huge, no value)
node_modules/
.pnp/
.pnp.js

# Next.js Build Outputs - Generated files, will change constantly
.next/
out/
dist/
build/

# Deployment Platforms
.vercel/
.netlify/
.turbo/

# Supabase - Local only, don't index
.supabase/

# Testing & Coverage - Generated reports
coverage/
.nyc_output/
test-results/
playwright-report/

# Environment Files - Sensitive data
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Logs - No value for AI
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE Settings (keep project settings, ignore personal)
.vscode/settings.json
.idea/workspace.xml
.idea/tasks.xml
*.swp
*.swo
*~

# Lock Files - Too large, no semantic value
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# Minified & Bundled Files - Not readable by AI
*.min.js
*.min.css
*.bundle.js
*.chunk.js
*.map

# Generated TypeScript Types - Will regenerate
types/database.types.ts
types/supabase.ts
.next/types/**

# Large Data Files - Too big for indexing
*.csv
*.xlsx
*.xls
*.json.gz
*.sql.gz
*.db
*.sqlite
*.sqlite3

# Database Dumps - Already in migrations
schema_dump.sql
dump.sql
backup*.sql

# Media Files - Binary, no code value
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot
*.mp4
*.webm
*.mp3
*.wav

# Documentation Build Outputs
docs/.vitepress/dist/
docs/.vitepress/cache/

# Temporary Files
*.tmp
*.temp
.cache/
tmp/
temp/

# Git Files (not needed in index)
.git/
.gitattributes

# Editor Backups
*~
\#*\#
.#*

# macOS Finder
.AppleDouble
.LSOverride

# Windows
$RECYCLE.BIN/

# Linux
.directory

# ============================================
# PROJECT SPECIFIC
# ============================================

# Large documentation archives (if you have them)
# docs/archived/
# docs/legacy/

# Test fixtures with large datasets
# __tests__/fixtures/large-dataset.json

# ============================================
# ✅ WHAT CURSOR WILL INDEX (Not ignored)
# ============================================
# ✅ .cursor/ folder (your rules and commands)
# ✅ .cursorrules file (project-wide rules)
# ✅ README.md (project context)
# ✅ package.json (dependencies context)
# ✅ tsconfig.json (TypeScript config)
# ✅ supabase/config.toml (Supabase config)
# ✅ All .ts, .tsx, .js, .jsx files (your code)
# ✅ All .md files in docs/ (documentation)
# ✅ supabase/migrations/*.sql (database schema)

# Add directories or file patterns to ignore during indexing (e.g. foo/ or *.csv)
